@model Models.Media


@if (Model != null)
{
    int connectedId = Models.User.ConnectedUser.Id;
    bool isVisible = Model.Shared || Models.User.ConnectedUser.IsAdmin || Model.OwnerId == connectedId;
    string likedUsersTooltip = "Usagers qui ont aimé:";
    if (Model.LikedUsers.Count > 0)
    {
        likedUsersTooltip += "\n" + string.Join("\n", Model.LikedUsers.Select(u => u.Name));
    }
    string likeIcon = Model.CurrentUserLikes ? "fa-solid fa-thumbs-up" : "fa-regular fa-thumbs-up";

    if (isVisible)
    {
        <dl>
            <dd>
                @if ((Models.User.ConnectedUser.Id == Model.OwnerId || Models.User.ConnectedUser.IsAdmin) && Model.Shared)
                {
                    <span style="color:grey">[Partagé]</span>
                }
            </dd>
            <dd class="mediaTitle">
                @Model.Title
            </dd>
            <dd class="mediaDetailsLikesPanel">
                <div class="mediaLikesBar">
                    <div class="mediaLikesCount @(Model.CurrentUserLikes ? "likedThumb" : "")" title="@likedUsersTooltip">
                        <span>@Model.LikesCount</span>
                    </div>

                    <div class="toggleLikeCmd mediaLikeButton"
                         mediaId="@Model.Id"
                         title="@(Model.CurrentUserLikes ? "Retirer j'aime" : "Ajouter j'aime")">
                        <span class="icon @likeIcon @(Model.CurrentUserLikes ? "likedThumb" : "")"></span>
                    </div>
                </div>
                <div id="detailsLikeState"
                     data-likes-count="@Model.LikesCount"
                     data-current-user-likes="@(Model.CurrentUserLikes.ToString().ToLower())"
                     data-liked-users-tooltip="Usagers qui ont aimé:@(Model.LikedUsers.Count > 0 ? "\n" + string.Join("\n", Model.LikedUsers.Select(u => u.Name)) : "")"
                     style="display:none">
                </div>
            </dd>
            <dd>
                @Helper.YoutubePlayer(Model.YoutubeId)
            </dd>
            <dd class="mediaDescription description">
                @Model.Description
            </dd>
            <dt>
                Catégorie
            </dt>

            <dd>
                @Model.Category
            </dd>

            <dt>
                Date de publication
            </dt>

            <dd>
                @Helper.When(Model.PublishDate)
            </dd>
            <dt>
                Ajouté par
            </dt>

            <dd class="owner" ownerid="@Model.OwnerId">
                @Helper.AvatarUser(Model.Owner)
            </dd>

        </dl>
    }
    else
    {
        <h2 style="color:red">Cette vidéo n'est plus partagée...</h2>
    }
}
else
{
    <h2 style="color:red">Cette vidéo a été effacée...</h2>
}
